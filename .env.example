# Salin ke .env.local (jangan di-commit). Kosongkan keduanya untuk mode lokal (localStorage).
# Hanya anon key atau publishable key (sb_publishable_...). JANGAN pernah service_role atau sb_secret_...: aplikasi menolaknya saat start.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
